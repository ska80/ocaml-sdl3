(library
 (name sdl3_image)
 (public_name sdl3-image)
 (libraries sdl3)
 (foreign_stubs
  (language c)
  (names image_stubs)
  (include_dirs
   (lib sdl3))
  (flags
   (:standard
    (:include c_flags.sexp))))
 (c_library_flags
  (:include c_library_flags.sexp)))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (deps
  (env_var PKG_CONFIG)
  (env_var PKG_CONFIG_PATH)
  (env_var PKG_CONFIG_LIBDIR)
  (env_var PKG_CONFIG_SYSROOT_DIR)
  (env_var PKG_CONFIG_ARGN))
 (action
  (run %{exe:../../config/discover.exe} --package sdl3-image)))
