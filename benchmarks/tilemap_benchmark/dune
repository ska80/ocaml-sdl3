(executable
 (name tilemap_benchmark)
 (modules tilemap_benchmark)
 (libraries sdl3 benchmark_support)
 (modes exe))

(rule
 (alias runtest)
 (package sdl3)
 (action
  (setenv
   SDL_VIDEO_DRIVER
   dummy
   (run
    %{exe:tilemap_benchmark.exe}
    --driver
    software
    --map-width
    96
    --map-height
    64
    --width
    132
    --height
    97
    --warmup
    1
    --frames
    3))))
