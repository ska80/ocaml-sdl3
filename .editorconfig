root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ml,mli}]
indent_style = space
indent_size = 2

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{cc,hh,cpp,hpp}]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 4

[*.{md,rst}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4
shell_variant = posix
switch_case_indent = true

[*.bat]
indent_style = space
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
