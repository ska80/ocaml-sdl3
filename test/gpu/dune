(executable
 (name gpu_test)
 (libraries sdl3)
 (modes exe byte_complete))

(rule
 (alias runtest-gpu)
 (package sdl3)
 (deps
  shaders/triangle.vert.spv
  shaders/triangle.frag.spv
  shaders/mesh.vert.spv
  shaders/mesh.frag.spv
  shaders/instanced.vert.spv
  shaders/renderer_effect.frag.spv
  shaders/renderer_fill.frag.spv
  shaders/resources.vert.spv
  shaders/resources.frag.spv)
 (action
  (progn
   (run %{exe:gpu_test.exe})
   (run ./gpu_test.bc.exe))))
