(test
 (name geometry_test)
 (package sdl3)
 (libraries sdl3)
 (modes exe byte_complete)
 (action
  (setenv
   SDL_VIDEO_DRIVER
   dummy
   (setenv
    SDL_RENDER_DRIVER
    software
    (run %{test})))))

(rule
 (alias runtest)
 (package sdl3)
 (action
  (setenv
   SDL_VIDEO_DRIVER
   dummy
   (setenv
    SDL_RENDER_DRIVER
    software
    (run ./geometry_test.bc.exe)))))

(rule
 (alias runtest-geometry)
 (package sdl3)
 (action
  (progn
   (run %{exe:geometry_test.exe})
   (run ./geometry_test.bc.exe))))
